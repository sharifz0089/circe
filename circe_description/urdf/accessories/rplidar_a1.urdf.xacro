<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rplidar_a1">

    <!--
      RPLidar A1 (A1M8) accessory for the CIRCE rover.

      No A1 mesh ships with roverrobotics_description (only rplidar_s2.dae), so the
      visual is approximated with primitives: a box for the base and a cylinder for
      the rotating scanner head.

      Datasheet figures used (RPLIDAR A1M8):
        body        98.5 x 70.0 x 60.0 mm
        range       0.15 - 12.0 m, 360 deg
        scan rate   5.5 Hz nominal, up to 10 Hz

      *** MEASURE BEFORE DRIVING ***
      lidar_mount_* below are the offsets from chassis_link to the A1's scan plane.
      x/y are carried over from the S2 mount point; z is an estimate. A wrong z puts
      obstacles at the wrong height in the costmap, and a wrong yaw makes the whole
      map rotate relative to the robot. Verify all four against the real build.

      Parented to chassis_link, not payload_link: CIRCE does not use the
      rover_dev_payload deck.

      lidar_mount_z is set on a RISER above the chassis top deck, not resting on it.
      The deck top (flipper_chassis.dae) is at z = +0.0630 in chassis_link, so a
      value of 0.170 puts the A1's base plate 0.170 - 0.041 = 0.129 up, i.e. a
      66 mm standoff above the deck.

      This clears the wheels, which was the point. The tyres reach 0.252 above
      ground (radius 0.1266 on a 0.125 axle) and the tracks reach 0.203; resting the
      A1 straight on the deck would have put the scan plane at 0.229, BELOW the
      tyre tops, so all four wheels would have shown up as permanent returns in
      fixed directions and wrecked scan matching. At 0.170 the scan plane is 0.295
      above ground, clearing the tyres by 43 mm.

      circe_sensor_mast.urdf.xacro derives the camera shelf height from
      lidar_mount_* and a1_scan_plane_z, so changing the values here moves the
      shelf too.

      Driver-side params for this sensor live in
      circe_bringup/config/lidar_a1.yaml; frame_id there must stay "lidar_link".

      NOTE: this is now a hardcoded height, no longer chassis_top_z +
      a1_scan_plane_z. If the deck height or the A1's internal geometry is
      remeasured, this value does not follow automatically, so recheck the standoff.
    -->
    <!-- Height of the scan plane above the A1's own base plate (approx). -->
    <xacro:property name="a1_scan_plane_z" value="0.041" />
    <xacro:property name="a1_base_height" value="0.020" />

    <!-- Top face of flipper_chassis.dae, measured from the mesh, in chassis_link. -->
    <xacro:property name="chassis_top_z" value="0.0630" />
    <xacro:property name="lidar_mount_x" value="0.18" />
    <xacro:property name="lidar_mount_y" value="0.0" />
    <xacro:property name="lidar_mount_z" value="0.170" />
    <xacro:property name="lidar_mount_yaw" value="3.1415" />
    <!-- base + rotor must total the datasheet's 60 mm so the modelled top matches
         the collision box and the shelf clearance computed by the mast. -->
    <xacro:property name="a1_rotor_height" value="0.040" />
    <xacro:property name="a1_rotor_radius" value="0.0355" />

    <!--
      lidar_link sits AT the scan plane, because that is the origin the driver
      stamps /scan with. Visuals are pushed downward from it to sit on the mount.
    -->
    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 ${-a1_scan_plane_z + a1_base_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="0.0985 0.070 ${a1_base_height}"/>
            </geometry>
        </visual>

        <visual>
            <origin xyz="0 0 ${-a1_scan_plane_z + a1_base_height + a1_rotor_height/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${a1_rotor_radius}" length="${a1_rotor_height}"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 ${-a1_scan_plane_z + 0.030}" rpy="0 0 0"/>
            <geometry>
                <box size="0.0985 0.070 0.060"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 ${-a1_scan_plane_z + 0.030}" rpy="0 0 0"/>
            <mass value="0.170" />
            <inertia ixx="7.0e-5" ixy="0.0" ixz="0.0" iyy="9.0e-5" iyz="0.0" izz="1.1e-4" />
        </inertial>
    </link>

    <joint name="lidar_to_chassis" type="fixed">
        <parent link="chassis_link"/>
        <child link="lidar_link"/>
        <origin xyz="${lidar_mount_x} ${lidar_mount_y} ${lidar_mount_z}"
                rpy="0 0 ${lidar_mount_yaw}"/>
    </joint>

    <!--
      Simulated A1. Sim only - see the sim_mode note in circe_rover.urdf.xacro.

      The Sensors system that renders this used to be declared below, inside the model.
      It is world-scoped in Harmonic and now lives in circe_gazebo/worlds/*.sdf; a
      gpu_lidar in a world without it produces no /scan at all.
    -->
    <xacro:arg name="sim_mode" default="false" />
    <xacro:if value="$(arg sim_mode)">
    <gazebo reference="lidar_link">
        <sensor name='gpu_lidar' type='gpu_lidar'>
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <!-- gz_frame_id: ignition_frame_id is the Fortress spelling. -->
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                <horizontal>
                    <!-- ~4000 samples/s at 5.5 Hz standard mode -> ~720 points/rev -->
                    <samples>720</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>0.0</max_angle>
                </vertical>
                </scan>
                <range>
                <min>0.15</min>
                <max>12.0</max>
                <resolution>0.01</resolution>
                </range>
                <!--
                  A real A1 is noisy; a noiseless sim scan makes scan matching look
                  better than it will be on hardware. 0.01 m sigma is the A1's quoted
                  accuracy.

                  Must sit inside <lidar>, not <sensor>. SDF silently accepts an
                  unknown child of <sensor> and only mutters "XML Element[noise] ...
                  not defined in SDF. Copying as children" during load, so a
                  misplaced noise block applies nothing at all and looks like it
                  worked.
                -->
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
            <visualize>true</visualize>
        </sensor>
    </gazebo>
    </xacro:if>

</robot>
